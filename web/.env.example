# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- MySQL (source of truth for structured records) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bootstrap_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=bootstrap_db

# --- Neo4j (relationship graph + recommendations) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# --- Auth ---
# Long random string used to sign session tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
